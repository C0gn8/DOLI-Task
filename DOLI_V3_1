]

CONCRETE = [
("edge","opinion"),("edge","attitude"),("edge","consideration"),
("sharpener","opinion"),("sharpener","attitude"),("sharpener","consideration"),
("boomerang","opinion"),("boomerang","attitude"),("boomerang","consideration")
]

ABSTRACT = [
("opinion","edge"),("opinion","sharpener"),("opinion","boomerang"),
("attitude","edge"),("attitude","sharpener"),("attitude","boomerang"),
("consideration","edge"),("consideration","sharpener"),("consideration","boomerang")
]

PRACTICE_A=[("aromatic","sharpener","edge"),("fragrant","boomerang","edge")]
PRACTICE_B=[("aromatic","attitude","opinion"),("fragrant","consideration","opinion")]

DISTRACTOR_A=[("fragrant aromatic","attitude","opinion"),
("smelly aromatic","consideration","opinion")]
DISTRACTOR_B=[("aromatic fragrant","sharpener","edge"),
("aromatic smelly","boomerang","edge")]

def build_pathway_a():
    trials=[]
    for i,p in enumerate(NONPREFERRED[:45]):
        l,r=CONCRETE[i%9]
        trials.append((p,l,r))
    for i,p in enumerate(PREFERRED[:45]):
        l,r=ABSTRACT[i%9]
        trials.append((p,l,r))
    return trials

def build_pathway_b():
    trials=[]
    for i,p in enumerate(PREFERRED[:45]):
        l,r=CONCRETE[i%9]
        trials.append((p,l,r))
    for i,p in enumerate(NONPREFERRED[:45]):
        l,r=ABSTRACT[i%9]
        trials.append((p,l,r))
    return trials

class DOLI:
    def __init__(self,root):
        self.root=root
        self.root.attributes("-fullscreen",True)

        self.pid=simpledialog.askstring("DOLI","Participant ID")
        self.pathway=random.choice(["A","B"])

        self.rows=[]

        self.prime=tk.Label(root,font=("Arial",28))
        self.prime.pack(pady=100)

        self.left=tk.Button(root,font=("Arial",20),width=20,
                            command=lambda:self.answer("left"))
        self.left.pack(side="left",expand=True)

        self.right=tk.Button(root,font=("Arial",20),width=20,
                             command=lambda:self.answer("right"))
        self.right.pack(side="right",expand=True)

        self.trials=[]
        if self.pathway=="A":
            self.trials.extend(build_pathway_a())
        else:
            self.trials.extend(build_pathway_b())

        random.shuffle(self.trials)
        self.i=0
        self.next_trial()

    def next_trial(self):
        if self.i>=len(self.trials):
            self.finish()
            return

        p,l,r=self.trials[self.i]
        self.current=(p,l,r)
        self.prime.config(text=p)
        self.left.config(text=l)
        self.right.config(text=r)
        self.start=time.perf_counter()

    def answer(self,side):
        rt=(time.perf_counter()-self.start)*1000
        p,l,r=self.current
        self.rows.append([self.pid,self.pathway,self.i+1,p,l,r,side,rt])
        self.i+=1
        self.root.after(ISI_MS,self.next_trial)

    def finish(self):
        Path("doli_output").mkdir(exist_ok=True)
        fn=Path("doli_output")/f"{self.pid}.csv"
        with open(fn,"w",newline="",encoding="utf8") as f:
            w=csv.writer(f)
            w.writerow(["participant","pathway","trial","prime","left","right","choice","rt_ms"])
            w.writerows(self.rows)
        messagebox.showinfo("DOLI",f"Saved to {fn}")
        self.root.destroy()

root=tk.Tk()
DOLI(root)
root.mainloop()
