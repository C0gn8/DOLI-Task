# ---------------------------------------------------------------------------
# Pathway builders — Tables 7-8
# ---------------------------------------------------------------------------
def build_pathway_a():
    trials = []
    for i, p in enumerate(PATHWAY_A_NONPREFERRED):
        l, r = CONCRETE[i % 9]
        trials.append((p, l, r))
    for i, p in enumerate(PATHWAY_A_PREFERRED):
        l, r = ABSTRACT[i % 9]
        trials.append((p, l, r))
    return trials

def build_pathway_b():
    trials = []
    for i, p in enumerate(PATHWAY_B_PREFERRED):
        l, r = CONCRETE[i % 9]
        trials.append((p, l, r))
    for i, p in enumerate(PATHWAY_B_NONPREFERRED):
        l, r = ABSTRACT[i % 9]
        trials.append((p, l, r))
    return trials

# ---------------------------------------------------------------------------
# Experiment
# ---------------------------------------------------------------------------
class DOLI:
    def __init__(self, root):
        self.root = root
        self.root.attributes("-fullscreen", True)

        self.pid = simpledialog.askstring("DOLI", "Participant ID")
        self.pathway = random.choice(["A", "B"])

        self.rows = []

        self.prime = tk.Label(root, font=("Arial", 28))
        self.prime.pack(pady=100)

        self.left = tk.Button(root, font=("Arial", 20), width=20,
                              command=lambda: self.answer("left"))
        self.left.pack(side="left", expand=True)

        self.right = tk.Button(root, font=("Arial", 20), width=20,
                               command=lambda: self.answer("right"))
        self.right.pack(side="right", expand=True)

        # Build trial sequence: practice → distractors → main trials (shuffled)
        if self.pathway == "A":
            practice = list(PRACTICE_A)
            distractors = list(DISTRACTOR_A)
            main = build_pathway_a()
        else:
            practice = list(PRACTICE_B)
            distractors = list(DISTRACTOR_B)
            main = build_pathway_b()

        random.shuffle(main)
        self.trials = practice + distractors + main
        self.practice_end = len(practice)
        self.distractor_end = len(practice) + len(distractors)

        self.i = 0
        self.next_trial()

    def next_trial(self):
        if self.i >= len(self.trials):
            self.finish()
            return
        p, l, r = self.trials[self.i]
        self.current = (p, l, r)
        self.prime.config(text=p)
        self.left.config(text=l)
        self.right.config(text=r)
        self.start = time.perf_counter()

    def trial_phase(self):
        if self.i < self.practice_end:
            return "practice"
        elif self.i < self.distractor_end:
            return "distractor"
        return "main"

    def answer(self, side):
        rt = (time.perf_counter() - self.start) * 1000
        p, l, r = self.current
        self.rows.append([self.pid, self.pathway, self.trial_phase(),
                          self.i + 1, p, l, r, side, rt])
        self.i += 1
        self.root.after(ISI_MS, self.next_trial)

    def finish(self):
        Path("doli_output").mkdir(exist_ok=True)
        fn = Path("doli_output") / f"{self.pid}.csv"
        with open(fn, "w", newline="", encoding="utf8") as f:
            w = csv.writer(f)
            w.writerow(["participant", "pathway", "phase", "trial",
                        "prime", "left", "right", "choice", "rt_ms"])
            w.writerows(self.rows)
        messagebox.showinfo("DOLI", f"Saved to {fn}")
        self.root.destroy()


root = tk.Tk()
DOLI(root)
root.mainloop()
