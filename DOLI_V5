st.set_page_config(
    page_title="DOLI Reconstruction",
    layout="wide"
)

if "started" not in st.session_state:
    st.session_state.started = False

if "trial_index" not in st.session_state:
    st.session_state.trial_index = 0

if "trial_start" not in st.session_state:
    st.session_state.trial_start = None

if "participant" not in st.session_state:
    st.session_state.participant = None

if not st.session_state.started:

    st.title("DOLI Reconstruction")

    participant = st.text_input(
        "Participant ID"
    )

    if st.button("Start"):

        st.session_state.participant = participant

        st.session_state.pathway = (
            get_block_assignment(
                "pathway",
                ["A", "B"]
            )
        )

        st.session_state.clqt_order = (
            get_block_assignment(
                "clqt",
                ["pre", "post"]
            )
        )

        st.session_state.trials = (
            build_trial_set(
                st.session_state.pathway
            )
        )

        st.session_state.logger = (
            DataLogger(
                participant,
                st.session_state.pathway,
                st.session_state.clqt_order
            )
        )

        st.session_state.started = True

        st.rerun()

else:

    trials = st.session_state.trials

    idx = st.session_state.trial_index

    if idx >= len(trials):

        st.success(
            "Experiment Complete"
        )

        st.stop()

    trial = trials[idx]

    if st.session_state.trial_start is None:

        st.session_state.trial_start = (
            time.perf_counter()
        )

    st.markdown(
        f"<h1 style='text-align:center'>{trial.prime}</h1>",
        unsafe_allow_html=True
    )

    col1, col2 = st.columns(2)

    with col1:

        left_clicked = st.button(
            trial.left,
            use_container_width=True
        )

    with col2:

        right_clicked = st.button(
            trial.right,
            use_container_width=True
        )

    if left_clicked or right_clicked:

        rt_ms = (
            time.perf_counter()
            - st.session_state.trial_start
        ) * 1000

        if left_clicked:

            side = "left"
            chosen = trial.left

        else:

            side = "right"
            chosen = trial.right

        st.session_state.logger.write(
            trial,
            idx + 1,
            side,
            chosen,
            rt_ms
        )

        st.session_state.trial_index += 1

        st.session_state.trial_start = None

        st.rerun()
