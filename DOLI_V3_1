
"""
DOLI Task v3.0 (publication-faithful reconstruction)

Built from:
Delgaram-Nejad et al. (2022) Applied Corpus Linguistics 2:100022

This implementation reconstructs:
- Pathway A / B generation rules
- Practice Lists A / B
- Distractor Lists A / B
- 950 ms ISI
- Participant random assignment
- CSV logging

Run:
    python DOLI_v3.py
"""

import tkinter as tk
from tkinter import simpledialog, messagebox
import random, csv, time
from pathlib import Path
from datetime import datetime

ISI_MS = 950

# Preferred and nonpreferred primes reconstructed from Tables 2–3
PREFERRED = [
