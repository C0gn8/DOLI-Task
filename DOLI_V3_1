"quiet stroked","silent stroked","deaf stroked",
"sour rough","spicy rough","salty rough",
"sour smoothed","spicy smoothed","salty smoothed",
"sour stroked","spicy stroked","salty stroked",
"rough aromatic","rough fragrant","rough smelly",
"smoothed aromatic","smoothed fragrant","smoothed smelly",
"stroked aromatic","stroked fragrant","stroked smelly",
