    "phase",
    "trial_number",

    "prime",

    "left_noun",
    "right_noun",

    "choice_side",
    "chosen_noun",

    "prime_type",
    "noun_order",

    "rt_ms",
    "timestamp"
]


class DataLogger:

    def __init__(
        self,
        participant,
        pathway,
        clqt_order
    ):

        filename = (
            f"{participant}_"
            f"{int(time.time())}.csv"
        )

        self.path = DATA_DIR / filename

        self.file = open(
            self.path,
            "w",
            newline="",
            encoding="utf8"
        )

        self.writer = csv.DictWriter(
            self.file,
            fieldnames=CSV_COLUMNS
        )

        self.writer.writeheader()

        self.participant = participant
        self.pathway = pathway
        self.clqt_order = clqt_order

    def write(
        self,
        trial,
        trial_number,
        choice_side,
        chosen_noun,
        rt_ms
    ):

        self.writer.writerow({

            "participant":
                self.participant,

            "pathway":
                self.pathway,

            "clqt_order":
                self.clqt_order,

            "phase":
                trial.phase,

            "trial_number":
                trial_number,

            "prime":
                trial.prime,

            "left_noun":
                trial.left,

            "right_noun":
                trial.right,

            "choice_side":
                choice_side,

            "chosen_noun":
                chosen_noun,

            "prime_type":
                trial.prime_type,

            "noun_order":
                trial.noun_order,

            "rt_ms":
                round(rt_ms, 3),

            "timestamp":
                time.time()
        })

        self.file.flush()

    def close(self):

        self.file.close()


