]

NONPREFERRED = [
"visual aromatic","watchful aromatic","scanned aromatic",
"visual fragrant","watchful fragrant","scanned fragrant",
"visual smelly","watchful smelly","scanned smelly",
"visual quiet","watchful quiet","scanned quiet",
"visual silent","watchful silent","scanned silent",
"visual deaf","watchful deaf","scanned deaf",
