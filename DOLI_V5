# ==================================================
# BLOCK RANDOMISATION
# ==================================================

def get_block_assignment(
    factor_name,
    conditions
):
    """
    Simple block randomisation.

    Example:

    get_block_assignment(
        "pathway",
        ["A", "B"]
    )

    Produces balanced assignments:

    A A B B
    shuffled
    """

    if BLOCK_FILE.exists():

        with open(
            BLOCK_FILE,
            "r",
            encoding="utf8"
        ) as f:

            state = json.load(f)

    else:

        state = {}

    if (
        factor_name not in state
        or
        len(state[factor_name]) == 0
    ):

        block = []

        for condition in conditions:
            block.extend([condition] * 2)

        random.shuffle(block)

        state[factor_name] = block

    assignment = state[factor_name].pop()

    with open(
        BLOCK_FILE,
        "w",
        encoding="utf8"
    ) as f:

        json.dump(
            state,
            f,
            indent=2
        )

    return assignment


