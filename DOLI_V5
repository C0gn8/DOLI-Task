# --------------------------------------------------
# COMPLETE TRIAL SET
# --------------------------------------------------

def build_trial_set(pathway):

    if pathway == "A":

        practice_source = PRACTICE_A
        distractor_source = DISTRACTOR_A
        main_trials = build_pathway_a()

    else:

        practice_source = PRACTICE_B
        distractor_source = DISTRACTOR_B
        main_trials = build_pathway_b()

    practice_trials = [

        Trial(
            phase="practice",
            prime=prime,
            left=left_noun,
            right=right_noun,
            pathway=pathway,
            prime_type="practice",
            noun_order="practice"
        )

        for prime, left_noun, right_noun
        in practice_source
    ]

    distractor_trials = [

        Trial(
            phase="distractor",
            prime=prime,
            left=left_noun,
            right=right_noun,
            pathway=pathway,
            prime_type="distractor",
            noun_order="distractor"
        )

        for prime, left_noun, right_noun
        in distractor_source
    ]

    random.shuffle(distractor_trials)
    random.shuffle(main_trials)

    return (
        practice_trials +
        distractor_trials +
        main_trials
    )


