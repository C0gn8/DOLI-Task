# --------------------------------------------------
# PATHWAY BUILDERS
# --------------------------------------------------

def build_pathway_a():

    trials = []

    for idx, (prime, left_noun, right_noun) in enumerate(PATHWAY_A_ROWS):

        trials.append(

            Trial(
                phase="main",
                prime=prime,
              left=left_noun,
            right=right_noun,
                pathway="A",
                prime_type=(
                    "nonpreferred"
                    if idx < 45
                    else "preferred"
                ),
                noun_order=(
                    "concrete_first"
                    if idx < 45
                    else "abstract_first"
                )
            )
        )

    return trials


